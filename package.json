{
  "name": "shopper-mcp",
  "version": "0.0.2",
  "description": "MCP server that lets an AI agent shop on marketplaces through a background browser",
  "mcpName": "io.github.eduard256/shopper-mcp",
  "type": "module",
  "bin": {
    "shopper-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "test": "node --import tsx --test \"test/**/*.test.ts\""
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eduard256/shopper-mcp.git"
  },
  "homepage": "https://github.com/eduard256/shopper-mcp#readme",
  "bugs": {
    "url": "https://github.com/eduard256/shopper-mcp/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ozon",
    "marketplace",
    "shopping",
    "ai-agent"
  ],
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "env-paths": "^4.0.0",
    "jq-wasm": "^3.0.0-jq-1.8.2",
    "patchright": "^1.64.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
